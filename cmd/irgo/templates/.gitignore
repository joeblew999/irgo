# Build artifacts
bin/
build/
tmp/

# Dependencies
node_modules/
vendor/

# Generated files
*_templ.go
static/css/output.css

# go.work is created by `irgo build/run android|ios` (gomobile needs it)
go.work
go.work.sum

# Native shells are generated by the irgo CLI (irgo build/run ios|android
# self-scaffold) from its embedded templates — NOT checked in.
ios/Example/
android/Example/

# Android example build outputs + machine-local SDK path
android/Example/build/
android/Example/.gradle/
android/Example/app/build/
android/Example/app/libs/irgo.aar
android/Example/local.properties

# Store packages produced by `irgo package`.
#
# irgo.package.toml is NOT ignored: it is shared config (app version, export
# method, store IDs) your team needs. Secrets go in irgo.package.local.toml,
# which is ignored, or in environment variables — which is how CI supplies them.
#
# appicon.png is deliberately NOT ignored: it is the single source icon YOU
# provide, and every platform icon is derived from it at build time. Ignoring
# it meant an icon never reached CI or teammates, so builds silently shipped
# the platform default.
dist/
irgo.package.local.toml

# Backups written by `irgo upgrade` when it replaces a file that had changed.
# Safe to delete once you have checked you did not lose a local edit.
*.irgo-bak

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
build-errors.log

# Environment
.env
.env.local
