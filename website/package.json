{
  "name": "irgo.dev",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun run build && bun --bun vite preview",
    "deploy": "bun run build && bun --bun wrangler deploy",
    "cf-typegen": "bun --bun wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.11.4",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.2",
    "wrangler": "^4.17.0"
  }
}
