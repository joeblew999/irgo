package templates

// DocsPage is the shell every documentation page sits in.
//
// Deliberately plain: this port exists to prove the docs can be an irgo app,
// and design work belongs after that is settled. The old TSX site stays live
// and unchanged until this one is worth switching to.
templ DocsPage(title string) {
	@Layout(title + " — irgo") {
		<div class="docs-shell">
			<aside class="docs-nav">
				<a class="brand" href="/">irgo</a>
				<nav>
					<a href="/docs/cli">CLI reference</a>
					<a href="/docs/getting-started">Getting started</a>
				</nav>
				<p class="docs-note">
					Served by Go, rendered with templ, running on Cloudflare
					Workers.
				</p>
			</aside>
			<main class="docs-main">
				{ children... }
			</main>
		</div>
	}
}

// GettingStarted is one ported page, enough to show what porting looks like
// next to a generated one.
templ GettingStarted() {
	@DocsPage("Getting started") {
		<h1>Getting started</h1>
		<p class="lede">Go, and nothing else you have to install yourself.</p>

		<h2>Create a project</h2>
		<pre><code>irgo project new myapp
cd myapp
go tool irgo server dev</code></pre>

		<p>
			The CLI provisions what a build needs when that build needs it:
			templ, the Tailwind standalone binary, air, gomobile, and the
			Android JDK, SDK and NDK — into <code>~/.irgo</code> or the Android
			SDK home, on macOS, Linux and Windows alike. No system package
			manager is involved, and <code>irgo tools remove</code> undoes it.
		</p>

		<p>
			Ask what this machine can do:
			<code>go tool irgo tools doctor</code>. The one thing irgo cannot
			install is Xcode, because only Apple can — <code>doctor</code> says
			so plainly. Android Studio is not required.
		</p>

		<h2>Run it everywhere</h2>
		<pre><code>go tool irgo app run desktop
go tool irgo app run ios
go tool irgo app run android
go tool irgo app deploy cloudflare</code></pre>
	}
}

// DocsHome is the landing page.
templ DocsHome() {
	@DocsPage("Documentation") {
		<h1>irgo</h1>
		<p class="lede">
			One Go codebase for web, desktop, iOS and Android — and now
			Cloudflare Workers. Server-driven HTML over SSE, no JavaScript
			framework, no Node.
		</p>

		<h2>Start here</h2>
		<p>
			<a href="/docs/getting-started">Getting started</a> — create a
			project and run it on every target.<br/>
			<a href="/docs/cli">CLI reference</a> — every command, generated
			from the CLI itself.
		</p>

		<h2>This site is an irgo app</h2>
		<p>
			It is Go and templ, compiled to WebAssembly and served from a
			Cloudflare Worker — the same <code>irgo app deploy cloudflare</code>
			any project uses. The CLI reference is rendered from the binary's
			own declarations, so it cannot document a command that does not
			exist.
		</p>
	}
}
